# Copy to .env and adjust. Never commit .env.
# The API checks these values at startup (src/common/config/env.validation.ts) and refuses to
# start, listing every problem, if one is missing or wrong.

# development, test or production (required). Jest sets test by itself; the server sets production.
NODE_ENV=development
PORT=3000
# Local PostgreSQL created as described in the README
DATABASE_URL=postgresql://kidzzy:kidzzy@localhost:5432/kidzzy_admin?schema=public

# Signs the access-token JWTs. At least 32 characters, different per environment; the API refuses
# this example value. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# Auth cookies are Secure (HTTPS only) unless this is false. Keep false only for local http;
# false is refused when NODE_ENV=production.
COOKIE_SECURE=false
# Login attempts allowed per IP per minute: a whole number, at least 1 (default 5)
LOGIN_RATE_LIMIT=5

# Used by `prisma:seed` to create the first admin if no user has this email yet.
# The password is never changed for an existing user.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
