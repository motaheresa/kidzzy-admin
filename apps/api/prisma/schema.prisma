// Prisma schema for the Academy Management System.
// Models are added story by story; this file follows the ERD V1 document.
//
// Conventions (ERD "Conventions"):
// - UUID primary keys, except join tables, which use composite keys.
// - Every academy-owned table has academy_id. The PrismaService extension adds it to every
//   query, so code never filters by academy by hand (NFR-01, ADR-0006).
// - Fields are camelCase in TypeScript and snake_case in the database (@map / @@map).
// - Timestamps are timestamptz in UTC.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Extensionless imports inside the generated client, so Jest (CommonJS) resolves them.
  importFileExtension = ""
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ── Identity and access ────────────────────────────────────────────────

/// The tenant itself; the only table without academy_id.
model Academy {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// IANA name, e.g. Africa/Cairo; drives schedules and reminders.
  timezone  String   @default("Africa/Cairo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users         User[]
  roles         Role[]
  refreshTokens RefreshToken[]
  students      Student[]
  groups        Group[]
  scheduleSlots ScheduleSlot[]
  sessions      Session[]
  enrollments   Enrollment[]
  paymentPlans  PaymentPlan[]
  paymentCycles PaymentCycle[]

  @@map("academies")
}

/// Everyone who logs in: admins and instructors.
/// At least one of email or phone is required (check constraint in the migration).
model User {
  id                 String   @id @default(uuid()) @db.Uuid
  academyId          String   @map("academy_id") @db.Uuid
  name               String
  /// The name in its search form (normalizeSearchText), written with every name (US-06).
  nameSearch         String   @map("name_search")
  email              String?
  phone              String?
  passwordHash       String   @map("password_hash")
  /// Deactivated users cannot log in; users are never deleted.
  isActive           Boolean  @default(true) @map("is_active")
  /// Set by an admin password reset; the user must choose a new password (US-02).
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academy          Academy        @relation(fields: [academyId], references: [id], onDelete: Restrict)
  roles            UserRole[]
  refreshTokens    RefreshToken[]
  groups           Group[]
  sessions         Session[] @relation("SessionInstructor")
  instructorPlans  PaymentPlan[]
  instructorCycles PaymentCycle[]

  @@unique([academyId, email])
  @@unique([academyId, phone])
  /// Composite key for tenant-safe foreign keys (groups.instructor_id, sessions.instructor_id).
  @@unique([id, academyId])
  @@map("users")
}

/// Admin and Instructor are seeded as system roles; V2 can add roles as data (NFR-02).
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  academyId String   @map("academy_id") @db.Uuid
  name      String
  /// True for the seeded Admin and Instructor roles, which cannot be deleted.
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academy     Academy          @relation(fields: [academyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([academyId, name])
  @@map("roles")
}

/// Global catalog shared by all academies (no academy_id).
/// A key is resource.action:scope, e.g. sessions.update:own (API Design V1, Permission keys).
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

/// Which permissions a role grants.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Which roles a user holds.
model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// One row per issued refresh token, stored as a SHA-256 hash (ADR-0005).
/// Every login starts a family; each refresh marks the old token used and adds a new one to the
/// family. Presenting a used token means it was stolen and replayed, so the whole family is revoked.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  academyId String    @map("academy_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Shared by every token since the login; it is the session id (sid) in the access token.
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the token is exchanged for a new one.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  /// Set on logout, on reuse detection, or when the user is deactivated.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

// ── Teaching ───────────────────────────────────────────────────────────

/// A student record (US-05). Students never log in in V1; they are deactivated, never deleted.
/// Check constraints in the migration: the code is stored trimmed and uppercase, the parent's
/// phone in the normalized form (like users), the age 3 to 25, the name not blank.
model Student {
  id          String   @id @default(uuid()) @db.Uuid
  academyId   String   @map("academy_id") @db.Uuid
  /// Entered by the admin (e.g. KC-001), unique per academy (FR-04).
  code        String
  name        String
  /// The name in its search form (normalizeSearchText), written with every name (US-06).
  nameSearch  String   @map("name_search")
  age         Int?     @db.SmallInt
  parentName  String   @map("parent_name")
  parentPhone String   @map("parent_phone")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academy     Academy        @relation(fields: [academyId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]
  plans       PaymentPlan[]
  cycles      PaymentCycle[]

  @@unique([academyId, code])
  /// Composite key for tenant-safe foreign keys: a later table (enrollments, attendance)
  /// references (student_id, academy_id), so it can never point at another academy's student.
  @@unique([id, academyId])
  @@map("students")
}

/// A class that meets on a weekly schedule (US-07). Never deleted: it is deactivated, and
/// inactive groups stop generating sessions.
model Group {
  id           String   @id @default(uuid()) @db.Uuid
  academyId    String   @map("academy_id") @db.Uuid
  name         String
  /// Course or level, e.g. Scratch 1.
  level        String
  /// normalizeSearchText(name + " " + level), written with every change of either (US-06 style).
  searchText   String   @map("search_text")
  instructorId String   @map("instructor_id") @db.Uuid
  /// First academy-local day sessions are generated from.
  startDate    DateTime @map("start_date") @db.Date
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academy     Academy        @relation(fields: [academyId], references: [id], onDelete: Restrict)
  /// Composite foreign key: the instructor must belong to the same academy as the group.
  instructor  User           @relation(fields: [instructorId, academyId], references: [id, academyId], onDelete: Restrict)
  slots       ScheduleSlot[]
  sessions    Session[]
  enrollments Enrollment[]

  /// Composite key for tenant-safe foreign keys (schedule_slots, sessions).
  @@unique([id, academyId])
  @@index([academyId, instructorId])
  @@map("groups")
}

/// A student's time in a group (US-08, US-09). The days it covers are start_date to end_date,
/// both included and academy-local; end_date null means the student is still in the group.
/// Leaving (a transfer or deactivation) on day D sets end_date = D - 1, so a day never belongs to
/// two enrollments. An enrollment that ends before it starts (end_date = start_date - 1) covered
/// no day. Check constraint in the migration: end_date >= start_date - 1.
model Enrollment {
  id        String    @id @default(uuid()) @db.Uuid
  academyId String    @map("academy_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId, academyId], references: [id, academyId], onDelete: Restrict)
  group   Group   @relation(fields: [groupId, academyId], references: [id, academyId], onDelete: Restrict)

  @@unique([id, academyId])
  /// AC (US-08): at most one open enrollment per student, so a student is in one group at a time.
  @@unique([studentId], map: "enrollments_student_open_key", where: raw("end_date IS NULL"))
  @@index([studentId, startDate])
  @@index([groupId])
  @@map("enrollments")
}

/// One weekly meeting of a group: a weekday, a start time in the academy's timezone and a length.
model ScheduleSlot {
  id          String    @id @default(uuid()) @db.Uuid
  academyId   String    @map("academy_id") @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday.
  weekday     Int       @db.SmallInt
  /// Local time in the academy's timezone ("16:00").
  startTime   DateTime  @map("start_time") @db.Time(0)
  durationMin Int       @map("duration_min") @db.SmallInt
  /// Set when the schedule changes while sessions (Held or Cancelled) still point at the slot: it
  /// stops generating and leaves the group's schedule but stays as history. Null = in use.
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  academy  Academy   @relation(fields: [academyId], references: [id], onDelete: Restrict)
  group    Group     @relation(fields: [groupId, academyId], references: [id, academyId], onDelete: Restrict)
  sessions Session[]

  /// Composite key for tenant-safe foreign keys (sessions.slot_id).
  @@unique([id, academyId])
  @@index([groupId])
  @@map("schedule_slots")
}

/// scheduled, held or cancelled (BR-01). Only held sessions get a number (BR-03).
enum SessionStatus {
  scheduled
  held
  cancelled

  @@map("session_status")
}

/// One meeting of a group (US-11). Generated from a weekly slot, or added as a make-up (null slot).
/// Check constraints and the notes on the slot pair are in the sessions migration.
model Session {
  id             String        @id @default(uuid()) @db.Uuid
  academyId      String        @map("academy_id") @db.Uuid
  groupId        String        @map("group_id") @db.Uuid
  /// The instructor on this session: who taught it, or who will teach it. Copied from the group
  /// when the session is generated, then updated only for sessions still ahead when the group's
  /// instructor changes. It can differ from the group's current instructor.
  instructorId   String        @map("instructor_id") @db.Uuid
  /// Null for make-up and extra sessions. slotAcademyId mirrors academyId whenever slotId is set:
  /// an optional composite foreign key needs its own nullable column (see the migration).
  slotId         String?       @map("slot_id") @db.Uuid
  slotAcademyId  String?       @map("slot_academy_id") @db.Uuid
  /// The slot's original academy-local date. A reschedule changes scheduledAt but keeps this, so
  /// the slot is never generated again for that day (unique with slotId).
  occurrenceDate DateTime?     @map("occurrence_date") @db.Date
  scheduledAt    DateTime      @map("scheduled_at") @db.Timestamptz(3)
  durationMin    Int           @map("duration_min") @db.SmallInt
  status         SessionStatus @default(scheduled)
  sessionNumber  Int?          @map("session_number")
  isMakeup       Boolean       @default(false) @map("is_makeup")
  /// The cancelled session a make-up replaces. Null for a generated session and for an extra.
  /// compensatesAcademyId mirrors academyId whenever the id is set (optional composite foreign key).
  compensatesSessionId String? @map("compensates_session_id") @db.Uuid
  compensatesAcademyId String? @map("compensates_academy_id") @db.Uuid
  cancelReason   String?       @map("cancel_reason")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  academy    Academy       @relation(fields: [academyId], references: [id], onDelete: Restrict)
  group      Group         @relation(fields: [groupId, academyId], references: [id, academyId], onDelete: Restrict)
  instructor User          @relation("SessionInstructor", fields: [instructorId, academyId], references: [id, academyId], onDelete: Restrict)
  slot       ScheduleSlot? @relation(fields: [slotId, slotAcademyId], references: [id, academyId], onDelete: Restrict)
  compensates Session?     @relation("SessionCompensation", fields: [compensatesSessionId, compensatesAcademyId], references: [id, academyId], onDelete: Restrict)
  makeups    Session[]     @relation("SessionCompensation")

  /// Generation inserts with ON CONFLICT DO NOTHING against this: running twice, or the job and a
  /// request at once, never duplicates a day (AC). Rows with a null slot never conflict.
  @@unique([slotId, occurrenceDate])
  /// BR-03: a number is unique per group. Rows with a null number never conflict.
  @@unique([groupId, sessionNumber])
  /// BR-04: a cancelled session has at most one make-up. Nulls are the sessions that compensate nothing.
  @@unique([compensatesSessionId], map: "sessions_one_makeup_key", where: raw("compensates_session_id IS NOT NULL"))
  /// Composite key for tenant-safe foreign keys (later: attendance, cycle_sessions).
  @@unique([id, academyId])
  @@index([groupId, scheduledAt])
  @@map("sessions")
}

// ── Payments ───────────────────────────────────────────────────────────

/// Who a plan or a cycle is for. The matching column (student_id or instructor_id) is set and
/// the other is null (check constraints in the migration).
enum PayeeType {
  student
  instructor

  @@map("payee_type")
}

enum CycleStatus {
  in_progress
  due
  paid

  @@map("cycle_status")
}

/// One version of a payee's plan: N sessions per cycle for an amount (US-08, US-20, US-21).
/// Versioned: a change inserts version + 1 and never edits a row (BR-10). Version 1 applies from
/// cycle 1; a later version applies from effective_from_cycle, the cycle after the open one, so the
/// cycle in progress keeps its plan. The references that may be null are composite foreign keys
/// through mirror columns (student_academy_id, instructor_academy_id), like sessions.slot_id.
model PaymentPlan {
  id                  String    @id @default(uuid()) @db.Uuid
  academyId           String    @map("academy_id") @db.Uuid
  payeeType           PayeeType @map("payee_type")
  studentId           String?   @map("student_id") @db.Uuid
  studentAcademyId    String?   @map("student_academy_id") @db.Uuid
  instructorId        String?   @map("instructor_id") @db.Uuid
  instructorAcademyId String?   @map("instructor_academy_id") @db.Uuid
  /// 1, 2, 3… per payee.
  version             Int
  /// N: a cycle is due when it counts N held sessions.
  sessionsPerCycle    Int       @map("sessions_per_cycle") @db.SmallInt
  /// Due per cycle, EGP.
  amount              Decimal   @db.Decimal(10, 2)
  effectiveFromCycle  Int       @map("effective_from_cycle")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  academy    Academy        @relation(fields: [academyId], references: [id], onDelete: Restrict)
  student    Student?       @relation(fields: [studentId, studentAcademyId], references: [id, academyId], onDelete: Restrict)
  instructor User?          @relation(fields: [instructorId, instructorAcademyId], references: [id, academyId], onDelete: Restrict)
  cycles     PaymentCycle[]

  @@unique([id, academyId])
  /// Target of payment_cycles' foreign key, which also carries N (see PaymentCycle).
  @@unique([id, academyId, sessionsPerCycle])
  /// NULLs are distinct in Postgres, so each pair only constrains its own payee type.
  @@unique([studentId, version])
  @@unique([instructorId, version])
  @@map("payment_plans")
}

/// A payee's cycle of N held sessions (FR-15, FR-16). Cycles are numbered 1, 2, 3… per payee and
/// belong to the payee, not to a group, so a transfer keeps them (BR-11). sessions_counted starts
/// at opening_count, the starting point, which only the payee's first cycle may have (BR-14).
/// Counting held sessions is US-22; nothing before it changes the counter.
model PaymentCycle {
  id                  String      @id @default(uuid()) @db.Uuid
  academyId           String      @map("academy_id") @db.Uuid
  payeeType           PayeeType   @map("payee_type")
  studentId           String?     @map("student_id") @db.Uuid
  studentAcademyId    String?     @map("student_academy_id") @db.Uuid
  instructorId        String?     @map("instructor_id") @db.Uuid
  instructorAcademyId String?     @map("instructor_academy_id") @db.Uuid
  /// The plan version in effect when the cycle started; a later version never changes it.
  planId              String      @map("plan_id") @db.Uuid
  /// The plan's N, copied so a check constraint can compare the counters with it. The foreign
  /// key (plan_id, academy_id, sessions_per_cycle) keeps it equal to the plan's.
  sessionsPerCycle    Int         @map("sessions_per_cycle") @db.SmallInt
  cycleNumber         Int         @map("cycle_number")
  openingCount        Int         @default(0) @map("opening_count") @db.SmallInt
  sessionsCounted     Int         @map("sessions_counted") @db.SmallInt
  status              CycleStatus @default(in_progress)
  dueAt               DateTime?   @map("due_at") @db.Timestamptz(3)
  paidAt              DateTime?   @map("paid_at") @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  academy    Academy     @relation(fields: [academyId], references: [id], onDelete: Restrict)
  student    Student?    @relation(fields: [studentId, studentAcademyId], references: [id, academyId], onDelete: Restrict)
  instructor User?       @relation(fields: [instructorId, instructorAcademyId], references: [id, academyId], onDelete: Restrict)
  plan       PaymentPlan @relation(fields: [planId, academyId, sessionsPerCycle], references: [id, academyId, sessionsPerCycle], onDelete: Restrict)

  @@unique([id, academyId])
  @@unique([studentId, cycleNumber])
  @@unique([instructorId, cycleNumber])
  /// At most one cycle in progress per payee.
  @@unique([studentId], map: "payment_cycles_student_open_key", where: raw("status = 'in_progress'"))
  @@unique([instructorId], map: "payment_cycles_instructor_open_key", where: raw("status = 'in_progress'"))
  @@index([planId])
  @@map("payment_cycles")
}
